{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Wordvault",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wordvault",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "identity"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://en.wiktionary.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/dom.js",
        "shared/styles.js",
        "shared/language-list.js",
        "shared/speech.js",
        "shared/stopwatch.js",
        "shared/quiz-card.js",
        "content/selection.js",
        "ui/popup/popup.js",
        "content/quiz.js",
        "content/triggers.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": [
        "core/hover/words.js",
        "core/hover/word-source.js",
        "core/hover/text-point.js",
        "core/hover/highlight.js",
        "core/hover/tracker.js",
        "core/hover/hover.js",
        "features/captions/selectors.js",
        "features/captions/adapters/youtube.js",
        "features/captions/captions.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wordvault@phobby",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
