{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Wordvault",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wordvault",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.mymemory.translated.net/*", "https://en.wiktionary.org/*"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/dom.js",
        "shared/styles.js",
        "shared/language-list.js",
        "shared/speech.js",
        "content/selection.js",
        "content/popup.js",
        "content/triggers.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
