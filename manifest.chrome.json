{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Wordvault",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wordvault",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "identity", "activeTab", "contextMenus", "offscreen", "scripting"],
  "commands": {
    "scan-screen": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Command+Shift+E", "windows": "Alt+Shift+S", "linux": "Alt+Shift+S", "chromeos": "Alt+Shift+S" },
      "description": "__MSG_cmdScanScreen__"
    }
  },
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://en.wiktionary.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/dom.js",
        "shared/styles.js",
        "shared/language-list.js",
        "shared/speech.js",
        "shared/stopwatch.js",
        "shared/progress-ui.js",
        "shared/quiz-answers.js",
        "shared/quiz-card.js",
        "content/selection.js",
        "shared/translate-client.js",
        "shared/passage-text.js",
        "ui/popup/popup.js",
        "content/quiz.js",
        "content/translate-button.js",
        "content/triggers.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": [
        "core/hover/words.js",
        "core/hover/word-source.js",
        "core/hover/text-point.js",
        "core/hover/highlight.js",
        "core/hover/tracker.js",
        "core/hover/hover.js",
        "features/captions/selectors.js",
        "features/captions/adapters/youtube.js",
        "features/captions/captions.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "core/hover/word-source.js",
        "features/screen-ocr/content/area.js",
        "features/screen-ocr/content/selector.js",
        "features/screen-ocr/content/layer.js",
        "features/screen-ocr/content/screen-ocr.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
